{% doc %}
  @prompt
    create collection carousel  its shows the product of the collection is chosen , image hight , badge diiscound , content padding , button high and width , make the the compare price and base price at the same line
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-collection-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-collection-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap_between_cards }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-collection-carousel-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
  }

  .ai-collection-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: {{ block.settings.badge_background_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
  }

  .ai-collection-carousel-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-collection-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    font-weight: 600;
  }

  .ai-collection-carousel-price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .ai-collection-carousel-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  .ai-collection-carousel-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }} {
    width: {{ block.settings.button_width }}%;
    height: {{ block.settings.button_height }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-collection-carousel-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-collection-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-collection-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-collection-carousel-nav-prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-collection-carousel-nav-next-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-collection-carousel-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px;
    color: #666;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-collection-carousel-nav-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.collection != blank %}
    <div class="ai-collection-carousel-container-{{ ai_gen_id }}">
      <button
        class="ai-collection-carousel-nav-{{ ai_gen_id }} ai-collection-carousel-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-collection-carousel-wrapper-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <div class="ai-collection-carousel-card-{{ ai_gen_id }}">
            <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-collection-carousel-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                <div class="ai-collection-carousel-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if product.compare_at_price > product.price and block.settings.show_discount_badge %}
                {% assign discount_percentage = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <div class="ai-collection-carousel-badge-{{ ai_gen_id }}">
                  -{{ discount_percentage }}%
                </div>
              {% endif %}
            </div>

            <div class="ai-collection-carousel-content-{{ ai_gen_id }}">
              <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>

              <div class="ai-collection-carousel-price-wrapper-{{ ai_gen_id }}">
                <span class="ai-collection-carousel-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </span>
                {% if product.compare_at_price > product.price %}
                  <span class="ai-collection-carousel-compare-price-{{ ai_gen_id }}">
                    {{ product.compare_at_price | money }}
                  </span>
                {% endif %}
              </div>

              <a href="{{ product.url }}">
                <button class="ai-collection-carousel-button-{{ ai_gen_id }}">
                  {{ block.settings.button_text }}
                </button>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>

      <button
        class="ai-collection-carousel-nav-{{ ai_gen_id }} ai-collection-carousel-nav-next-{{ ai_gen_id }}"
        aria-label="Next"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% else %}
    <div class="ai-collection-carousel-empty-{{ ai_gen_id }}">
      <p>Please select a collection to display products</p>
    </div>
  {% endif %}
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-collection-carousel-wrapper-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-collection-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-collection-carousel-nav-next-{{ ai_gen_id }}');

        if (this.prevButton && this.nextButton && this.wrapper) {
          this.setupNavigation();
        }
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => {
          const scrollAmount = this.wrapper.offsetWidth;
          this.wrapper.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });

        this.nextButton.addEventListener('click', () => {
          const scrollAmount = this.wrapper.offsetWidth;
          this.wrapper.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

