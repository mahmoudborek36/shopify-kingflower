{% doc %}
  @prompt
    A horizontal row collection carousel

    Each item contains:

    Circular image inside a circle frame.

    A thin soft pink border around the circle.

    A category title below the image in uppercase text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    margin: 0 auto;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  /* Desktop: center items */
  @media screen and (min-width: 750px) {
    .ai-collection-carousel__container-{{ ai_gen_id }} {
      display: flex;
      flex-wrap: nowrap;
      justify-content: center;
      gap: {{ block.settings.item_spacing }}px;
      padding: 20px 0;
    }
  }

  /* Mobile: scrollable row */
  @media screen and (max-width: 749px) {
    .ai-collection-carousel__container-{{ ai_gen_id }} {
      display: flex;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: {{ block.settings.item_spacing }}px;
      padding: 20px 12px;
    }
  }

  .ai-collection-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    width: {{ block.settings.item_width }}px;
  }

  .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.circle_size }}px;
    height: {{ block.settings.circle_size }}px;
    border-radius: 50%;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    overflow: hidden;
    margin-bottom: {{ block.settings.title_spacing }}px;
    transition: transform 0.3s ease;
  }

  .ai-collection-carousel__item-{{ ai_gen_id }}:hover .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 1px;
    font-weight: 500;
    margin: 0;
  }

  .ai-collection-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  /* Mobile sizing */
  @media screen and (max-width: 749px) {
    .ai-collection-carousel__item-{{ ai_gen_id }} {
      width: {{ block.settings.item_width | times: 0.8 }}px;
    }

    .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.circle_size | times: 0.8 }}px;
      height: {{ block.settings.circle_size | times: 0.8 }}px;
    }

    .ai-collection-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.collections.size > 0 %}
    <div class="ai-collection-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-carousel__container-{{ ai_gen_id }}">
        {% for collection in block.settings.collections %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-carousel__item-{{ ai_gen_id }}"
          >
            <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 400 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div class="ai-collection-carousel__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">
              {{ collection.title }}
            </h3>
          </a>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="ai-collection-carousel__empty-state-{{ ai_gen_id }}">
      Next, add collections to display in the carousel
    </div>
  {% endif %}
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-collection-carousel__wrapper-{{ ai_gen_id }}');

        if (this.wrapper) {
          this.setupScrollBehavior();
        }
      }

      setupScrollBehavior() {
        // Only enable drag-scroll on mobile / when overflow is active
        let isDown = false;
        let startX;
        let scrollLeft;

        this.wrapper.addEventListener('mousedown', (e) => {
          if (window.innerWidth >= 750) return;
          isDown = true;
          this.wrapper.style.cursor = 'grabbing';
          startX = e.pageX - this.wrapper.offsetLeft;
          scrollLeft = this.wrapper.scrollLeft;
        });

        this.wrapper.addEventListener('mouseleave', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mouseup', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.wrapper.offsetLeft;
          const walk = (x - startX) * 2;
          this.wrapper.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Circle style"
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Circle size",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#FFC0CB"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "item_width",
      "label": "Item width",
      "min": 100,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "label": "Title spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Collection carousel"
    }
  ]
}
{% endschema %}
