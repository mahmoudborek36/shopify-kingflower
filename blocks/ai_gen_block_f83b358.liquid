{% doc %}
  @prompt
    About us floating icon on left bottm 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-floating-icon-{{ ai_gen_id }} {
    position: fixed;
    bottom: {{ block.settings.bottom_position }}px;
    left: {{ block.settings.left_position }}px;
    z-index: 9999;
    display: block;
  }

  .ai-floating-icon-button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.icon_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    border: none;
    padding: 0;
  }

  .ai-floating-icon-button-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 1.5 }});
    background-color: {{ block.settings.hover_background_color }};
    color: {{ block.settings.hover_icon_color }};
  }

  .ai-floating-icon-svg-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
  }

  @media screen and (max-width: 749px) {
    .ai-floating-icon-{{ ai_gen_id }} {
      bottom: {{ block.settings.bottom_position_mobile }}px;
      left: {{ block.settings.left_position_mobile }}px;
    }

    .ai-floating-icon-button-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-floating-icon-svg-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size_mobile }}px * 0.5);
      height: calc({{ block.settings.icon_size_mobile }}px * 0.5);
    }
  }
{% endstyle %}

<div class="ai-floating-icon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a
    href="{{ block.settings.link_url }}"
    class="ai-floating-icon-button-{{ ai_gen_id }}"
    aria-label="{{ block.settings.aria_label }}"
  >
    <svg
      class="ai-floating-icon-svg-{{ ai_gen_id }}"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
  </a>
</div>

{% schema %}
{
