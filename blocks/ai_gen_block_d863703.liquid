{% doc %}
  @prompt
    Add get it touch seaction with adressa nd embad map email,  phone  hours 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-contact-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-contact-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .ai-contact-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px 0;
  }

  .ai-contact-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px 0;
    line-height: 1.5;
  }

  .ai-contact-details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-contact-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-contact-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: {{ block.settings.icon_color }};
  }

  .ai-contact-item-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-contact-item-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 4px 0;
  }

  .ai-contact-item-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-contact-item-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-contact-item-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_color }};
  }

  .ai-contact-map-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    border-radius: {{ block.settings.map_border_radius }}px;
    border: none;
  }

  .ai-contact-map-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    border-radius: {{ block.settings.map_border_radius }}px;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-contact-map-placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f5f5f5;
    color: #666;
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  @media screen and (max-width: 768px) {
    .ai-contact-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-contact-map-{{ ai_gen_id }},
    .ai-contact-map-wrapper-{{ ai_gen_id }},
    .ai-contact-map-placeholder-{{ ai_gen_id }} {
      min-height: 300px;
    }
  }
{% endstyle %}

<get-in-touch-{{ ai_gen_id }} class="ai-contact-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-container-{{ ai_gen_id }}">
    <div class="ai-contact-info-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-contact-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-contact-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      <div class="ai-contact-details-{{ ai_gen_id }}">
        {% if block.settings.address != blank %}
          <div class="ai-contact-item-{{ ai_gen_id }}">
            <div class="ai-contact-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="ai-contact-item-content-{{ ai_gen_id }}">
              <p class="ai-contact-item-label-{{ ai_gen_id }}">Address</p>
              <p class="ai-contact-item-text-{{ ai_gen_id }}">{{ block.settings.address }}</p>
            </div>
          </div>
        {% endif %}

        {% if block.settings.email != blank %}
          <div class="ai-contact-item-{{ ai_gen_id }}">
            <div class="ai-contact-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="ai-contact-item-content-{{ ai_gen_id }}">
              <p class="ai-contact-item-label-{{ ai_gen_id }}">Email</p>
              <a href="mailto:{{ block.settings.email }}" class="ai-contact-item-text-{{ ai_gen_id }} ai-contact-item-link-{{ ai_gen_id }}">{{ block.settings.email }}</a>
            </div>
          </div>
        {% endif %}

        {% if block.settings.phone != blank %}
          <div class="ai-contact-item-{{ ai_gen_id }}">
            <div class="ai-contact-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="ai-contact-item-content-{{ ai_gen_id }}">
              <p class="ai-contact-item-label-{{ ai_gen_id }}">Phone</p>
              <a href="tel:{{ block.settings.phone }}" class="ai-contact-item-text-{{ ai_gen_id }} ai-contact-item-link-{{ ai_gen_id }}">{{ block.settings.phone }}</a>
            </div>
          </div>
        {% endif %}

        {% if block.settings.hours != blank %}
          <div class="ai-contact-item-{{ ai_gen_id }}">
            <div class="ai-contact-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="ai-contact-item-content-{{ ai_gen_id }}">
              <p class="ai-contact-item-label-{{ ai_gen_id }}">Hours</p>
              <div class="ai-contact-item-text-{{ ai_gen_id }}">{{ block.settings.hours }}</div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-contact-map-wrapper-{{ ai_gen_id }}">
      {% if block.settings.map_embed_code != blank %}
        {{ block.settings.map_embed_code }}
      {% else %}
        <div class="ai-contact-map-placeholder-{{ ai_gen_id }}">
          Add your map embed code in the block settings
        </div>
      {% endif %}
    </div>
  </div>
</get-in-touch-{{ ai_gen_id }}>

<script>
  (function() {
    class GetInTouch{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustMapIframe();
      }

      adjustMapIframe() {
        const mapWrapper = this.querySelector('.ai-contact-map-wrapper-{{ ai_gen_id }}');
        if (!mapWrapper) return;

        const iframe = mapWrapper.querySelector('iframe');
        if (iframe) {
          iframe.classList.add('ai-contact-map-{{ ai_gen_id }}');
          iframe.setAttribute('width', '100%');
          iframe.setAttribute('height', '100%');
        }
      }
    }

    customElements.define('get-in-touch-{{ ai_gen_id }}', GetInTouch{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Get in touch",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>We'd love to hear from you. Visit us or reach out through any of the channels below.</p>"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Main Street\nCity, State 12345\nCountry"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@example.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+1 (555) 123-4567"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours",
      "default": "Monday - Friday: 9:00 AM - 6:00 PM\nSaturday: 10:00 AM - 4:00 PM\nSunday: Closed"
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "html",
      "id": "map_embed_code",
      "label": "Map embed code",
      "info": "Paste your Google Maps or other map embed code here"
    },
    {
      "type": "range",
      "id": "map_border_radius",
      "label": "Map border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Get in touch"
    }
  ]
}
{% endschema %}
